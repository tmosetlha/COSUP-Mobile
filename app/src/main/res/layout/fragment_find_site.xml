<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/findScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCATOR"
            android:textColor="?attr/cosupGreenDark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Find a site"
            android:textColor="?attr/cosupText"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/siteSearch"
            style="@style/CosupInput"
            android:layout_marginTop="12dp"
            android:hint="Search by site, suburb or service"
            android:inputType="text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Use my location"
            android:textAllCaps="false"
            app:backgroundTint="@color/cosup_green"
            app:cornerRadius="26dp" />

        <TextView
            android:id="@+id/locateMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/cosupMuted"
            android:textSize="13sp" />

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:id="@+id/siteList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distances are straight-line estimates and travel times are approximate. Tap Drive, Walk or Transit for the live route in Google Maps."
            android:textColor="?attr/cosupMuted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
